# Copy to .env and fill in. Never commit .env.
RG_API_KEY=
# Language of item names from the API: de,en,ru,ja,in,es,fr
RG_LANG=en
# Language of Telegram messages: en | lv  (the web page has its own LV/EN switch)
UI_LANG=en
DB_PATH=resources.db

# Telegram (@BotFather -> token, @userinfobot -> chat id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Credits: the schedule uses about 19 per day
MIN_CREDITS=20
DAILY_CREDIT_BUDGET=40
TICK_MINUTES=10

# Alerts
WAREHOUSE_ALERT_HOURS=6
MARKET_PREMIUM_PCT=8
PRICE_ALERT_PCT=15
PRICE_MIN_STOCK_VALUE=10000000000
MISSION_DEADLINE_HOURS=6
DAILY_REPORT_HOUR=20
# Mission IDs to never announce (41 epidemic, 42 accident, 56 ad)
MISSION_IGNORE=41,42,56
# Item IDs never suggested for selling (kits, TU, troops, drones, detectors ...)
MARKET_IGNORE=42,43,44,45,46,48,96,98,99,103,104,117,120,159,160,161,166,167

# Mines: fetch condition when the prediction reaches this level
MAINT_CHECK_LEVEL=0.93
MAINT_DECAY_PER_DAY=0.04

# Warehouse capacity = A * level ^ B (measured: 5000 * level^2)
WAREHOUSE_CAP_A=5000
WAREHOUSE_CAP_B=2
